# ============================================================================
# dsh-led-bridge —— 仓库忽略规则
# ============================================================================

# ---- 依赖 ----------------------------------------------------------------
node_modules/

# ---- pnpm 运行时产物 ------------------------------------------------------
# 这两个是 pnpm 在本机生成/给本机用的，**不能进仓库**：
#   pnpm-workspace.yaml 里含着本机的 allowBuilds 授权决定，
#   而且它会把这个目录变成 workspace 根，破坏 `pnpm pack`。
pnpm-lock.yaml
pnpm-workspace.yaml

# ---- 打包产物（由 scripts/pack.ps1 生成）--------------------------------
dist/
*.tgz
*.zip

# ---- 编译产物 ------------------------------------------------------------
# firmware/build/        是 scripts/build.ps1 的输出目录
# firmware/*/build/      是 arduino-cli 的编译缓存（含 sdkconfig 等中间文件）
firmware/build/
firmware/*/build/

# ---- 编辑器 / 系统杂项 ---------------------------------------------------
.DS_Store
Thumbs.db
*.log
*.bak
*.bak2
